<script>
	// Calcule et affiche la durée de chaque expérience du Parcours,
	// recalculé à chaque visite (pas figé au moment du build).
	function formatDuration(startStr: string, endStr: string) {
		const [sy, sm] = startStr.split('-').map(Number);
		const now = new Date();
		const [ey, em] =
			endStr === 'present'
				? [now.getFullYear(), now.getMonth() + 1]
				: endStr.split('-').map(Number);
		let months = (ey - sy) * 12 + (em - sm);
		if (months < 1) months = 1;
		const years = Math.floor(months / 12);
		const rest = months % 12;
		const parts: string[] = [];
		if (years) parts.push(`${years} an${years > 1 ? 's' : ''}`);
		if (rest || !years) parts.push(`${rest} mois`);
		return parts.join(' ');
	}

	document.querySelectorAll<HTMLElement>('.duration-badge[data-start]').forEach((el) => {
		const { start, end } = el.dataset;
		if (start && end) el.textContent = formatDuration(start, end);
	});
</script>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-bottom: 2.5rem;
  }

  img {
    margin-top: 1.5rem;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
  }

  section > .cv {
    grid-column: 2;
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .content {
    grid-column: 2 / 4;
  }

  .content > .background {
    padding-bottom: 2rem;
  }

  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  .content-logo {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8em 2em;
    text-align: center;
  }

  .logo-img {
    display: block;
    width: 3em;
    height: 3em;
    margin-top: 0;
    border-radius: 0.6em;
    object-fit: cover;
    vertical-align: top;
  }

  .soft-skills {
    display: flex;
    gap: 3em;
  }

  h3 {
    margin-bottom: 0.5em;
    font-size: var(--text-lg);
  }

  .cv-img {
    margin-top: 0;
    width: 100%;
  }

  .cv-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    place-content: center;
    margin: 2.5rem auto;
    padding: 0.56em 2em;
    white-space: nowrap;
    border-radius: 999rem;
    overflow: hidden;

    text-align: center;
    text-decoration: none !important;
    line-height: 1.1;
    color: var(--accent-text-over);

    background: var(--gradient-accent-orange);
    box-shadow: var(--shadow-md);
  }

  .cv-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background-color var(--theme-transition);
    mix-blend-mode: overlay;
  }

  .cv-btn:focus::after,
  .cv-btn:hover::after {
    background-color: hsla(var(--gray-999-basis), 0.3);
  }

  @media (min-width: 20em) {
    .cv-btn {
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    section {
      display: contents;
      font-size: var(--text-lg);
    }

    .cv-btn {
      padding: 1.125rem 2.5rem;
      font-size: var(--text-xl);
    }
  }

  .duration-badge {
    display: inline-block;
    margin-top: 0.35em;
    padding: 0.2em 0.7em;
    color: var(--accent-regular);
    background-color: var(--gray-999_40);
    border: 1px solid var(--gray-800);
    border-radius: 999rem;
    font-size: var(--text-sm);
  }

  .duration-badge:empty {
    display: none;
  }
</style>
